{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"cli": {
		"packageManager": "npm"
	},
	"newProjectRoot": "libs",
	"projects": {
		"miles": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "apps/miles",
			"sourceRoot": "apps/miles/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"outputPath": "dist/miles",
						"index": "apps/miles/src/index.html",
						"main": "apps/miles/src/main.ts",
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "apps/miles/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "apps/miles/public",
								"output": "."
							}
						],
						"styles": [
							"apps/miles/src/styles.scss"
						],
						"scripts": [],
						"extraWebpackConfig": "apps/miles/webpack.config.js",
						"commonChunk": false
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all",
							"extraWebpackConfig": "apps/miles/webpack.prod.config.js"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "miles:build:production",
							"extraWebpackConfig": "apps/miles/webpack.prod.config.js"
						},
						"development": {
							"buildTarget": "miles:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4203,
						"publicHost": "http://localhost:4203",
						"extraWebpackConfig": "apps/miles/webpack.config.js"
					}
				},
				"extract-i18n": {
					"builder": "@angular-devkit/build-angular:extract-i18n"
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "apps/miles/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "apps/miles/public"
							}
						],
						"styles": [
							"apps/miles/src/styles.scss"
						],
						"scripts": []
					}
				}
			}
		},
		"federation": {
			"projectType": "library",
			"root": "libs/shared/federation",
			"sourceRoot": "libs/shared/federation/src",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular-devkit/build-angular:ng-packagr",
					"options": {
						"project": "libs/shared/federation/ng-package.json"
					},
					"configurations": {
						"production": {
							"tsConfig": "libs/shared/federation/tsconfig.lib.prod.json"
						},
						"development": {
							"tsConfig": "libs/shared/federation/tsconfig.lib.json"
						}
					},
					"defaultConfiguration": "production"
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"tsConfig": "libs/shared/federation/tsconfig.spec.json",
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						]
					}
				}
			}
		}
	}
}